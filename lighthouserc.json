{
  "ci": {
    "collect": {
      "staticDistDir": "."
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8, "urlPattern": "index" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "urlPattern": "index" }],
        "categories:best-practices": ["error", { "minScore": 0.85, "urlPattern": "index" }],
        "categories:seo": ["error", { "minScore": 0.9, "urlPattern": "index" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 300000, "urlPattern": "index" }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 1200000, "urlPattern": "index" }]
      }
    }
  }
}
